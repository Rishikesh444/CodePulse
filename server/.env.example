# CodePulse-Lite Server Configuration
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/codepulse_lite

# AI Debugging Provider Configuration
# Set AI_API_KEY to enable live LLM diagnoses (Gemini or OpenAI format).
# If left empty, CodePulse-Lite automatically uses the rule-based fallback engine.
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_PROVIDER=gemini
